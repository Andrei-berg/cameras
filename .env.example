# Скопируйте в .env.local и заполните значениями. Значения НЕ коммитить.
# .env.local читают: Prisma (prisma.config.ts), Next, скрипты в scripts/ (tsx).

# --- База данных (Supabase, ТОЛЬКО pooler aws-1-eu-central-1.pooler.supabase.com) ---
# Локально/раннтайм: порт 6543 (transaction). Миграции: порт 5432 (session).
DATABASE_URL=

# --- Better Auth ---
# Секрет для подписи сессий/токенов (обязателен в проде). Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Публичные (уходят в браузер, префикс NEXT_PUBLIC_) ---
# Базовый URL приложения, напр. http://localhost:3000 или https://cameras-nu.vercel.app
NEXT_PUBLIC_APP_URL=
# Ключ Yandex Maps — бесплатный, ТОЛЬКО API 2.1
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# --- Почта (Resend) ---
# Требуется на этапе сборки (new Resend(...) на уровне модуля). Для CI годится dummy re_123.
RESEND_API_KEY=
# Адрес отправителя; по умолчанию onboarding@resend.dev
RESEND_FROM_EMAIL=

# --- Cron ---
# Защита эндпоинта /api/cron/snapshot (ежедневный снапшот 8:00 МСК)
CRON_SECRET=

# --- Скрипты (пути к исходным Excel-файлам, только для локального импорта) ---
# scripts/import-cameras.ts — реестр камер
REGISTRY_FILE=
# scripts/enrich-coordinates.ts — выгрузка КСВД
KSVD_FILE=
